{
  "name": "flowdoc",
  "version": "0.6.35",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "next dev --webpack --port 4000",
    "build": "next build",
    "start": "next start --port 4000",
    "type-check": "tsc --noEmit",
    "test": "npm run test:core && npm run test:app",
    "test:core": "npm run test -w packages/core --",
    "test:app": "vitest run",
    "test:pdf-visual": "node scripts/run-pdf-visual-regression.mjs",
    "dev:wysiwyg": "node scripts/dev-wysiwyg.mjs",
    "review:build": "node scripts/review-build.mjs",
    "review:gate": "npm run type-check && npm run test && npm run review:build",
    "review:gate:full": "npm run review:archive -- --check && npm run review:gate",
    "review:archive": "node scripts/create-review-archive.mjs",
    "review:browser": "node scripts/review-browser.mjs",
    "review:browser:install": "playwright install chromium && npm run review:browser",
    "mock:flowdoc": "node scripts/generate-flowdoc-mocks.mjs",
    "smoke:editor": "node scripts/editor-smoke.mjs",
    "smoke:wysiwyg-table-cell-boundary": "node scripts/wysiwyg-table-cell-boundary-smoke.mjs",
    "smoke:wysiwyg-table-cell-boundary-matrix": "node scripts/wysiwyg-table-cell-boundary-matrix-smoke.mjs",
    "smoke:wysiwyg-table-cell-boundary-matrix-probe": "node scripts/wysiwyg-table-cell-boundary-matrix-probe.mjs",
    "smoke:wysiwyg-table-cell-boundary-matrix-repeat": "node scripts/wysiwyg-table-cell-boundary-matrix-smoke.mjs --repeat=3 --compact",
    "smoke:wysiwyg-flow-table-colspan-boundary": "node scripts/wysiwyg-table-cell-boundary-smoke.mjs --target=flow-table-colspan",
    "smoke:wysiwyg-flow-table-colspan-overcase": "node scripts/wysiwyg-table-cell-boundary-smoke.mjs --target=flow-table-colspan-overcase",
    "smoke:wysiwyg-flow-table-rowspan-boundary": "node scripts/wysiwyg-table-cell-boundary-smoke.mjs --target=flow-table-rowspan",
    "smoke:wysiwyg-flow-table-mixed-span-boundary": "node scripts/wysiwyg-table-cell-boundary-smoke.mjs --target=flow-table-mixed-span",
    "smoke:wysiwyg-rich-draft": "node scripts/wysiwyg-rich-draft-smoke.mjs",
    "smoke:wysiwyg-stage4c": "node scripts/wysiwyg-stage4c-smoke.mjs",
    "smoke:outline-panel": "node scripts/outline-panel-smoke.mjs",
    "smoke:outline-panel-list-draft": "node scripts/outline-panel-list-draft-smoke.mjs",
    "smoke:outline-panel-list-draft-repeat": "node scripts/outline-panel-list-draft-repeat-smoke.mjs",
    "smoke:outline-panel-list-subtree-reorder": "node scripts/outline-panel-list-subtree-reorder-smoke.mjs",
    "smoke:outline-panel-list-subtree-reorder-repeat": "node scripts/outline-panel-list-subtree-reorder-repeat-smoke.mjs",
    "smoke:outline-panel-active-list-reorder": "node scripts/outline-panel-active-list-reorder-smoke.mjs",
    "smoke:outline-panel-active-list-reorder-repeat": "node scripts/outline-panel-active-list-reorder-repeat-smoke.mjs",
    "smoke:outline-panel-invalid-list-reorder": "node scripts/outline-panel-invalid-list-reorder-smoke.mjs",
    "smoke:outline-panel-invalid-list-reorder-repeat": "node scripts/outline-panel-invalid-list-reorder-repeat-smoke.mjs",
    "smoke:wysiwyg-list-level-draft": "node scripts/wysiwyg-list-level-active-draft-smoke.mjs",
    "smoke:wysiwyg-list-level-draft-repeat": "node scripts/wysiwyg-list-level-active-draft-smoke.mjs --repeat=3",
    "smoke:wysiwyg-list-level-draft-repeat5": "node scripts/wysiwyg-list-level-active-draft-smoke.mjs --repeat=5",
    "smoke:wysiwyg-reenter": "node scripts/wysiwyg-reenter-drift-probe.mjs",
    "smoke:wysiwyg-thai-repeat": "node scripts/wysiwyg-thai-repeat-reenter-probe.mjs",
    "smoke:wysiwyg-smoothness": "node scripts/wysiwyg-smoothness-probe.mjs",
    "smoke:wysiwyg-stress-lifecycle": "node scripts/wysiwyg-stress-lifecycle-smoke.mjs",
    "smoke:wysiwyg-stress-lifecycle-repeat": "node scripts/wysiwyg-stress-lifecycle-smoke.mjs --repeat=3",
    "smoke:wysiwyg-stress-lifecycle-repeat5": "node scripts/wysiwyg-stress-lifecycle-smoke.mjs --repeat=5",
    "diagnose:wysiwyg-click": "node scripts/wysiwyg-click-diagnostic.mjs",
    "perf:baseline": "node scripts/flowdoc-performance-baseline.mjs",
    "perf:install-browser": "npx playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "linebreak": "^1.1.0",
    "next": "^16.2.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "wordcut": "^0.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
